# Blackboard Integration Toolkit Configuration
BB_BASE_URL=https://your-blackboard-instance.com
BB_CLIENT_ID=your_client_id
BB_CLIENT_SECRET=your_client_secret
BB_TOKEN_URL=https://your-blackboard-instance.com/learn/api/public/v1/oauth2/token
BB_TIMEOUT=60
BB_MAX_RETRIES=3
BB_RATE_LIMIT_ENABLED=true
BB_RATE_LIMIT_CALLS_PER_SECOND=5.0
BB_RATE_LIMIT_BURST=10
BB_LOG_LEVEL=INFO
BB_LOG_JSON=false